---
---
<aside class="floating-ai-badge" aria-label="AI Generated Content Hinweis">
  <div class="circle-ai" title="AI Assisted Architecture & Development">
    <span>AI</span>
  </div>
</aside>

<style>
  .floating-ai-badge {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 40;
    pointer-events: auto;
    user-select: none;
  }

  .circle-ai {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--header-bg);
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--card-shadow);
    cursor: default;
    transition: all 0.25s ease;
  }

  .floating-ai-badge:hover .circle-ai {
    background: var(--accent);
    color: var(--bg-main);
    box-shadow: 0 0 16px var(--accent);
    transform: scale(1.08);
  }

  /* Smartphone-Format: 36px Durchmesser, spart Screen-Fläche */
  @media (max-width: 640px) {
    .floating-ai-badge {
      bottom: 14px;
      right: 14px;
    }
    .circle-ai {
      width: 36px;
      height: 36px;
      font-size: 0.75rem;
      border-width: 1.5px;
    }
  }
</style>