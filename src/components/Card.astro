---
interface Props {
  title: string;
  date: string | Date;
  excerpt: string;
  slug: string;
}

const { title, date, excerpt, slug } = Astro.props;
const formattedDate = date instanceof Date ? date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' }) : new Date(date).toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="card">
  <div class="card-meta">
    <time>{formattedDate}</time>
  </div>
  <h3>{title}</h3>
  <p>{excerpt}</p>
  <a href={`/blog/${slug}/`} class="card-link">Artikel lesen &rarr;</a>
</article>

<style>
  .card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .card-meta time {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
    color: var(--accent);
  }
  .card h3 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--text-main);
  }
  .card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    flex-grow: 1;
  }
  .card-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: 0.5rem;
  }
  .card-link:hover {
    text-decoration: underline;
  }
</style>