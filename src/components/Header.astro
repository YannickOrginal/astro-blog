---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");
---

<div class="header-floating-wrapper">
  <header class="header">
    <div class="nav-container">
      <a href="/" class="logo-link" aria-label="Startseite">
        <span class="circle-logo">YD</span>
      </a>
      
      <nav class="nav-links">
        <a href="/" class={currentPath === "" ? "active" : ""}>Home</a>
        <a href="/blog" class={currentPath.startsWith("/blog") ? "active" : ""}>Blog</a>
        <a href="/about" class={currentPath === "/about" ? "active" : ""}>About</a>
      </nav>

      <!-- 3-Positionen Theme Switch -->
      <div class="theme-switch-wrapper">
        <div class="theme-switch" role="group" aria-label="Farbpaletten Schalter">
          <div class="theme-slider" id="theme-slider"></div>
          <button type="button" class="theme-btn" data-theme="day" title="Tag-Modus">☀️</button>
          <button type="button" class="theme-btn" data-theme="night" title="Nacht-Modus">🌙</button>
          <button type="button" class="theme-btn" data-theme="sunset" title="Sonnenuntergang">🌇</button>
        </div>
      </div>
    </div>

    <!-- Scroll-Fortschrittsleiste -->
    <div class="scroll-track" id="scroll-track">
      <div class="scroll-fill" id="scroll-fill"></div>
      <div class="scroll-cursor-bubble" id="scroll-cursor-bubble"></div>
      <div class="milestone-bubble" style="left: 25%;" data-point="25"></div>
      <div class="milestone-bubble" style="left: 50%;" data-point="50"></div>
      <div class="milestone-bubble" style="left: 75%;" data-point="75"></div>
      <div class="milestone-bubble" style="left: 100%;" data-point="100"></div>
    </div>
  </header>
</div>

<script is:inline>
  const root = document.documentElement;
  const buttons = document.querySelectorAll('.theme-btn');
  const slider = document.getElementById('theme-slider');
  const themes = ['day', 'night', 'sunset'];

  function applyTheme(theme) {
    root.classList.remove('theme-night', 'theme-sunset');
    if (theme === 'night') root.classList.add('theme-night');
    if (theme === 'sunset') root.classList.add('theme-sunset');
    
    const idx = themes.indexOf(theme);
    if (slider && idx !== -1) {
      slider.style.transform = `translateX(${idx * 100}%)`;
    }
    localStorage.setItem('yd_theme', theme);
  }

  const storedTheme = localStorage.getItem('yd_theme') || 'night';
  applyTheme(storedTheme);

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-theme');
      applyTheme(selected);
    });
  });

  const scrollFill = document.getElementById('scroll-fill');
  const cursorBubble = document.getElementById('scroll-cursor-bubble');
  const track = document.getElementById('scroll-track');
  const milestoneBubbles = document.querySelectorAll('.milestone-bubble');

  function updateScrollProgress() {
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (docHeight <= 0) {
      if (track) track.style.opacity = '0';
      return;
    }
    if (track) track.style.opacity = '1';

    const scrolled = (window.scrollY / docHeight) * 100;
    const clamped = Math.min(Math.max(scrolled, 0), 100);

    if (scrollFill) scrollFill.style.width = `${clamped}%`;
    if (cursorBubble) cursorBubble.style.left = `${clamped}%`;

    milestoneBubbles.forEach((mb) => {
      const pt = parseFloat(mb.getAttribute('data-point') || '0');
      if (clamped >= pt) {
        mb.classList.add('reached');
      } else {
        mb.classList.remove('reached');
      }
    });
  }

  window.addEventListener('scroll', updateScrollProgress, { passive: true });
  window.addEventListener('resize', updateScrollProgress);
  document.addEventListener('DOMContentLoaded', updateScrollProgress);
</script>

<style>
  .header-floating-wrapper {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    z-index: 100;
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0 16px;
    pointer-events: none;
    isolation: isolate;
  }

  /* Exakter 1:1 .glass-card Shader */
  .header {
    pointer-events: auto;
    position: relative;
    width: 100%;
    max-width: 860px;
    height: 66px;
    border-radius: 9999px;
    overflow: hidden;

    transform: translateZ(0);
    will-change: backdrop-filter;

    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(40px);

    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -1px 0 rgba(255, 255, 255, 0.1),
      inset 0 0 12px 6px rgba(255, 255, 255, 0.6);

    transition: all 0.3s ease;
  }

  /* Exakte .glass-card Lichtkante Oben */
  .header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.8),
      transparent
    );
    pointer-events: none;
    z-index: 3;
  }

  /* Exakte .glass-card Lichtkante Links */
  .header::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.8),
      transparent,
      rgba(255, 255, 255, 0.3)
    );
    pointer-events: none;
    z-index: 3;
  }

  .nav-container {
    height: 100%;
    padding: 0 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  .logo-link {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    text-decoration: none;
    letter-spacing: -0.5px;
  }

  .circle-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--accent, #38bdf8);
    background: rgba(56, 189, 248, 0.08);
    color: var(--accent, #38bdf8);
    font-family: ui-monospace, monospace;
    font-weight: 700;
    transition: all 0.25s ease;
  }

  .logo-link:hover .circle-logo {
    background: var(--accent, #38bdf8);
    color: var(--bg-main, #0f172a);
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.4);
    transform: scale(1.05);
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .nav-links a:hover { color: var(--text-main); }
  .nav-links a.active { color: var(--accent); }

  /* 3-Position Slider */
  .theme-switch-wrapper {
    display: flex;
    align-items: center;
  }

  .theme-switch {
    position: relative;
    display: flex;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2px;
    width: 96px;
    height: 32px;
    box-sizing: border-box;
  }

  .theme-slider {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 30px;
    height: 26px;
    background: var(--accent);
    opacity: 0.25;
    border-radius: 16px;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .theme-btn {
    flex: 1;
    position: relative;
    z-index: 2;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: transform 0.15s ease;
  }

  .theme-btn:hover {
    transform: scale(1.15);
  }

  /* Scroll Track & Bubbles */
  .scroll-track {
    position: absolute;
    bottom: 0;
    left: 28px;
    right: 28px;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 4;
  }

  .scroll-fill {
    height: 100%;
    width: 0%;
    border-radius: 9999px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    transition: width 0.05s linear;
  }

  .scroll-cursor-bubble {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--text-main);
    box-shadow: 0 0 6px var(--accent);
    pointer-events: none;
    transition: left 0.05s linear;
  }

  .milestone-bubble {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--border);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .milestone-bubble.reached {
    background: var(--accent);
    transform: translate(-50%, -50%) scale(1.4);
    box-shadow: 0 0 6px var(--accent);
  }

  @media (max-width: 600px) {
    .header-floating-wrapper {
      top: 0.5rem;
      padding: 0 10px;
    }
    .header {
      height: 58px;
    }
    .nav-container {
      padding: 0.6rem 1rem;
    }
    .nav-links {
      gap: 0.75rem;
    }
    .circle-logo {
      width: 36px;
      height: 36px;
    }
  }
</style>