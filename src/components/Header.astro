---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<div class="header-floating-wrapper">
  <header class="header">
    <div class="header-container">
      <a href="/" class="logo-link" aria-label="Startseite">
        <div class="logo-circle">
          <span>YD</span>
        </div>
      </a>

      <nav class="nav-links" aria-label="Hauptnavigation">
        <a href="/" class:list={['nav-pill', { active: pathname === '/' }]}>Home</a>
        <a href="/blog" class:list={['nav-pill', { active: pathname.startsWith('/blog') }]}>Blog</a>
        <a href="/about" class:list={['nav-pill', { active: pathname === '/about' }]}>About</a>
      </nav>

      <div class="theme-switch-wrapper">
        <div class="theme-switch" role="group" aria-label="Farbschema wählen">
          <button id="theme-day" class="theme-btn" type="button" title="Tag-Modus">☀️</button>
          <button id="theme-night" class="theme-btn" type="button" title="Nacht-Modus">🌙</button>
          <button id="theme-sunset" class="theme-btn" type="button" title="Sonnenuntergang-Modus">🌇</button>
        </div>
      </div>
    </div>

    <!-- Scroll-Progress-Balken an der Unterkante -->
    <div class="scroll-progress-track">
      <div id="scroll-progress-bar" class="scroll-progress-fill"></div>
    </div>
  </header>
</div>

<script is:inline>
  (function () {
    const applyTheme = (theme) => {
      document.documentElement.classList.remove('theme-night', 'theme-sunset');
      if (theme === 'night') document.documentElement.classList.add('theme-night');
      if (theme === 'sunset') document.documentElement.classList.add('theme-sunset');
      localStorage.setItem('theme', theme);
    };

    const savedTheme = localStorage.getItem('theme') || 'night';
    applyTheme(savedTheme);

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('theme-day')?.addEventListener('click', () => applyTheme('day'));
      document.getElementById('theme-night')?.addEventListener('click', () => applyTheme('night'));
      document.getElementById('theme-sunset')?.addEventListener('click', () => applyTheme('sunset'));
    });

    const updateProgress = () => {
      const progressBar = document.getElementById('scroll-progress-bar');
      if (!progressBar) return;

      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = Math.min(Math.max(progress, 0), 100) + '%';
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    document.addEventListener('DOMContentLoaded', updateProgress);
  })();
</script>

<style>
  /* Schwebende Wrapper-Positionierung mit sauberer Layer-Isolation */
  .header-floating-wrapper {
    position: sticky;
    top: 1rem;
    z-index: 100;
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0 16px;
    pointer-events: none;
    isolation: isolate; /* Verhindert Stacking-Konflikte mit darunterliegendem Content */
  }

  /* Die abgerundete Glas-Pille mit GPU-beschleunigtem Blur */
  .header {
    pointer-events: auto;
    position: relative;
    width: 100%;
    max-width: 860px;
    height: 66px;
    border-radius: 9999px;
    
    /* Compositor-Zuweisung fuer zuverlaessiges Rendering */
    transform: translateZ(0);
    will-change: backdrop-filter;
    
    /* Glassmorphism mit Fallback */
    background-color: var(--header-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.45),
                0 0 20px rgba(0, 0, 0, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.15);
    overflow: hidden;
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .header-container {
    height: 100%;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo links */
  .logo-link {
    text-decoration: none;
  }

  .logo-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    color: var(--accent);
    background: rgba(255, 255, 255, 0.05);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    transition: all 0.2s ease;
  }

  .logo-link:hover .logo-circle {
    background: var(--accent);
    color: var(--bg-main);
    box-shadow: 0 0 16px var(--accent);
    transform: scale(1.05);
  }

  /* Navigation: Kapsel-Buttons */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 80px;
    height: 36px;
    padding: 0 0.9rem;
    border-radius: 9999px;
    border: 1px solid transparent;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    box-sizing: border-box;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-pill:hover {
    border-color: var(--border-hover);
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 14px var(--accent), inset 0 0 6px var(--accent);
    transform: translateY(-1px);
  }

  .nav-pill:active {
    transform: scale(0.96);
  }

  .nav-pill.active {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 0 12px var(--accent);
  }

  /* Theme Switcher */
  .theme-switch-wrapper {
    display: flex;
    align-items: center;
  }

  .theme-switch {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 3px;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border);
  }

  .theme-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    padding: 4px 6px;
    border-radius: 50%;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .theme-btn:hover {
    transform: scale(1.15);
    background: rgba(255, 255, 255, 0.12);
  }

  /* Scroll-Progressbar */
  .scroll-progress-track {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--progress-bg, rgba(255, 255, 255, 0.08));
  }

  .scroll-progress-fill {
    width: 0%;
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    transition: width 0.08s linear;
  }

  /* Responsive Anpassungen */
  @media (max-width: 640px) {
    .header-floating-wrapper {
      top: 0.5rem;
      padding: 0 10px;
    }
    .header {
      height: 58px;
    }
    .header-container {
      padding: 0 0.85rem;
    }
    .nav-pill {
      min-width: 64px;
      height: 32px;
      font-size: 0.8rem;
      padding: 0 0.5rem;
    }
    .logo-circle {
      width: 34px;
      height: 34px;
      font-size: 0.8rem;
    }
  }
</style>