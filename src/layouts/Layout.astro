---
import Header from '../components/Header.astro';
import AiBadge from '../components/AiBadge.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Yannick Derouaux | Living Proof', description = 'Persönliche Website und Blog zu Systemarchitektur, Engineering und IT.' } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <AiBadge />
    <script src="/scripts/swipe.js" defer></script>
  </body>
</html>

<style is:global>
  /* Global forciert, damit keine Sub-Komponente den Header ueberlappt */
  .site-main {
    min-height: calc(100vh - 80px);
    padding-top: 5.5rem !important;
    display: block;
  }

  @media (max-width: 640px) {
    .site-main {
      padding-top: 4.5rem !important;
    }
  }
</style>