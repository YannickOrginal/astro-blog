---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Über mich | Yannick Derouaux">
  <main class="container">
    <section class="profile-header">
      <h1>Yannick Derouaux</h1>
      <p class="tagline">Staatlich geprüfter Elektrotechniker & Systems Builder</p>
    </section>

    <div class="bento-grid">
      <div class="card card-wide">
        <h3>Fokus & Handwerk</h3>
        <p>
          Spezialisiert auf elektrische Dokumentation, Systemsteuerungen, Netzwerk-Infrastruktur 
          und Automatisierung. Erfahrung in Industrieanlagen, CAD/ECAD-Workflows sowie praktischer 
          Schaltungs- und Fehleranalyse.
        </p>
      </div>

      <div class="card">
        <h3>Tech Stack</h3>
        <ul class="tech-list">
          <li>TypeScript / Astro</li>
          <li>Linux / Debian / RouterOS</li>
          <li>VLANs / Unbound / Zero Trust</li>
          <li>E-CAD / Meridian</li>
        </ul>
      </div>

      <div class="card">
        <h3>Interessen</h3>
        <p>
          High-Performance Hardware, Custom Setups, Performance-Tuning und 
          lokale LLM-Workflows via Ollama & Aider.
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 24px 80px 24px;
  }
  .profile-header {
    margin-bottom: 2.5rem;
  }
  .profile-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    color: var(--text-main);
  }
  .tagline {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--accent);
    font-size: 1.05rem;
    margin: 0;
  }
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: border-color 0.15s ease;
  }
  .card:hover {
    border-color: var(--border-hover);
  }
  .card-wide {
    grid-column: span 2;
  }
  .card h3 {
    margin: 0 0 0.75rem 0;
    color: var(--text-main);
    font-size: 1.2rem;
  }
  .card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .tech-list {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--text-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
  }
  .tech-list li {
    margin-bottom: 0.35rem;
  }
  @media (max-width: 640px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .card-wide {grid-column: span 1;
    }
  }
</style>