---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')) || [];
posts.sort((a, b) => {
  const dateA = new Date(a.data?.pubDate || a.data?.date || 0).valueOf();
  const dateB = new Date(b.data?.pubDate || b.data?.date || 0).valueOf();
  return dateB - dateA;
});
---

<Layout title="Blog | Yannick Derouaux">
  <div class="blog-container">
    <header class="blog-header">
      <h1 class="headline">Projekte-Blog &amp; Deep Dives</h1>
      <p class="lead-text">
        Detaillierte Einblicke in Systemarchitekturen, Netzwerk-Segmentierung, Kraftwerksdokumentation und lokale KI-Toolchains.
      </p>
    </header>

    <div class="blog-stack">
      {posts.map((post) => {
        const slug = post.id || post.slug || '';
        const title = post.data?.title || post.id || 'Ohne Titel';
        const desc = post.data?.description || '';
        const rawDate = post.data?.pubDate || post.data?.date;
        let formattedDate = '';
        if (rawDate) {
          const d = new Date(rawDate);
          if (!isNaN(d.getTime())) {
            formattedDate = d.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
          }
        }
        return (
          <article class="card blog-card">
            <h2 class="card-title">{title}</h2>
            {formattedDate && <time class="card-date">{formattedDate}</time>}
            {desc && <p class="card-desc">{desc}</p>}
            <a href={'/blog/' + slug} class="card-action">Artikel lesen &rarr;</a>
          </article>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .blog-container {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 24px 80px 24px;
  }
  .blog-header {
    margin-bottom: 2.5rem;
  }
  .headline {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin: 0 0 1rem 0;
  }
  .lead-text {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }
  .blog-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .blog-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .card-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.35;
  }
  .card-date {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
    color: var(--accent);
    display: block;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  .card-desc {
    margin: 0 0 1.25rem 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .card-action {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: transform 0.15s ease;
  }
  .card-action:hover {
    transform: translateX(4px);
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .headline {
      font-size: 1.85rem;
    }
  }
</style>