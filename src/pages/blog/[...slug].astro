---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const rawId = post.id || post.slug || '';
    const cleanSlug = rawId.replace(/\.[^/.]+$/, '');
    return {
      params: { slug: cleanSlug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data?.title || 'Blogpost';
const desc = post.data?.description || '';
const rawDate = post.data?.pubDate || post.data?.date;
let formattedDate = '';
if (rawDate) {
  const d = new Date(rawDate);
  if (!isNaN(d.getTime())) {
    formattedDate = d.toLocaleDateString('de-DE', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  }
}
---

<Layout title={`${title} | Yannick Derouaux`} description={desc}>
  <main class="post-container">
    <a href="/blog" class="back-link">&larr; Zurück zur Übersicht</a>
    <article class="prose card">
      <header class="post-header">
        {formattedDate && <time datetime={new Date(rawDate).toISOString()}>{formattedDate}</time>}
        <h1>{title}</h1>
        {desc && <p class="description">{desc}</p>}
      </header>
      <hr class="divider" />
      <div class="content">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .post-container {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 24px 80px 24px;
  }
  .back-link {
    color: var(--accent);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  .prose {
    padding: 2.5rem;
  }
  .post-header time {
    color: var(--accent);
    font-size: 0.9rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .post-header h1 {
    font-size: 2.25rem;
    margin: 0 0 1rem 0;
    line-height: 1.25;
    color: var(--text-main);
  }
  .description {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
  }
  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
  .content {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .content :global(h2) {
    font-size: 1.6rem;
    margin: 2rem 0 1rem 0;
    color: var(--text-main);
  }
  .content :global(h3) {
    font-size: 1.3rem;
    margin: 1.5rem 0 0.75rem 0;
    color: var(--text-main);
  }
  .content :global(p) {
    margin: 0 0 1.5rem 0;
    color: var(--text-muted);
  }
  .content :global(ul), .content :global(ol) {
    margin: 0 0 1.5rem 0;
    padding-left: 1.5rem;
  }
  .content :global(li) {
    margin-bottom: 0.5rem;
  }
  .content :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: var(--accent);
  }
  .content :global(pre) {
    background: rgba(0, 0, 0, 0.4) !important;
    border: 1px solid var(--border);
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .content :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--text-main);
  }
  @media (max-width: 640px) {
    .prose {
      padding: 1.5rem;
    }
  }
</style>