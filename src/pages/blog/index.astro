---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import '../../styles/global.css';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog | Archiv</title>
  </head>
  <body>
    <Header />
    <main class="container">
      <header class="page-header">
        <h1>Artikel &amp; Dokumentation</h1>
        <p class="subtitle">Gesammelte Aufzeichnungen, Tutorials und technische Einblicke.</p>
      </header>

      <section class="grid-section">
        <div class="posts-grid">
          {posts.map((post) => (
            <article class="post-card">
              <div class="card-meta">
                <time datetime={post.data.pubDate ? new Date(post.data.pubDate).toISOString() : ''}>
                  {post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString('de-DE') : ''}
                </time>
              </div>
              <h2>{post.data.title}</h2>
              {post.data.description && <p>{post.data.description}</p>}
              <a href={`/blog/${post.id}/`} class="read-link">
                Weiterlesen <span>&rarr;</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .container {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 24px 80px 24px;
  }
  .page-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .page-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    color: var(--text-main);
  }
  .subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin: 0;
  }
  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .post-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .post-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }
  .card-meta time {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
    color: var(--accent);
  }
  .post-card h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-main);
  }
  .post-card p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }
  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-top: 0.5rem;
  }
  .read-link:hover {
    text-decoration: underline;
  }
  .read-link span {
    transition: transform 0.15s ease;
  }
  .read-link:hover span {
    transform: translateX(3px);
  }
</style>