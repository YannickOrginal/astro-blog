---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import '../styles/global.css';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 5);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yannick | Engineering & Systems</title>
  </head>
  <body>
    <Header />
    <main class="container">
      <section class="hero">
        <span class="badge">&lt;dev /&gt;</span>
        <h1>Engineering &amp; Systems</h1>
        <p class="subtitle">
          Praxisnahe Notizen, Deep Dives und Analysen zu Elektrotechnik, System-Architektur, Linux und Performance.
        </p>
      </section>

      <section class="feed">
        <div class="section-header">
          <h2>Neueste Beiträge</h2>
          <a href="/blog" class="all-link">Alle ansehen &rarr;</a>
        </div>

        <div class="posts-list">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="post-row">
              <div class="row-meta">
                <time datetime={post.data.pubDate ? new Date(post.data.pubDate).toISOString() : ''}>
                  {post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString('de-DE') : ''}
                </time>
              </div>
              <div class="row-body">
                <h3>{post.data.title}</h3>
                {post.data.description && <p>{post.data.description}</p>}
              </div>
              <span class="arrow">&rarr;</span>
            </a>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .container {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 24px 80px 24px;
  }
  .hero {
    margin-bottom: 3.5rem;
  }
  .badge {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    color: var(--accent);
    background: rgba(88, 166, 255, 0.1);
    border: 1px solid var(--border);
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin: 0 0 1rem 0;
    color: var(--text-main);
  }
  .subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .section-header h2 {
    font-size: 1.35rem;
    color: var(--text-main);
    margin: 0;
  }
  .all-link {
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .all-link:hover {
    text-decoration: underline;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .post-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .post-row:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }
  .row-meta time {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .row-body {
    flex-grow: 1;
  }
  .row-body h3 {
    margin: 0 0 0.35rem 0;
    font-size: 1.15rem;
    color: var(--text-main);
  }
  .row-body p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .arrow {
    color: var(--text-muted);
    font-size: 1.15rem;
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .post-row:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .post-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .arrow {
      display: none;
    }
  }
</style>